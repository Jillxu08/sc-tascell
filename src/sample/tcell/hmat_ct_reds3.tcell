(def worker-data
  (def n int)
  (def leafnode-list (ptr leafmtx))
  (def lnmtx (array int 3))
  (def nlf uint64_t)
  (def elem-sum uint64_t)
  (def cas-start int)
  (def cas-counter int)

  (def gpu-lr-cnt int)
  (def cpu-lr-cnt int)
  (def gpu-ds-cnt int)
  (def cpu-ds-cnt int)
  (def gpu-lr-elem uint64_t)
  (def cpu-lr-elem uint64_t)
  (def gpu-ds-elem uint64_t)
  (def cpu-ds-elem uint64_t)

  (def pen-ds-gpu-subm uint64_t)
  (def pen-ds-gpu-elem uint64_t)
  (def pen-lr-gpu-subm uint64_t)
  (def pen-lr-gpu-elem uint64_t)
  (def ds-cpu-time double)
  (def lr-cpu-time double)
  (def ds-gpu-time double)
  (def lr-gpu-time double)
)

(def Wdata-list (array (ptr (struct worker-data)) NWORKER-MAX))

(def worker-init
  (= (aref Wdata-list WORKER-ID) (ptr WDATA))
  (= WDATA.n BCTN)
  (= WDATA.leafnode-list (cast (ptr leafmtx) (csym::malloc (* WDATA.n (sizeof leafmtx)))))
  (= (aref WDATA.lnmtx 0) 0)
  (= (aref WDATA.lnmtx 1) 0)
  (= (aref WDATA.lnmtx 2) 0)
  (= WDATA.nlf 0)
  (= WDATA.elem-sum 0)

  (= WDATA.gpu-lr-cnt 0)
  (= WDATA.cpu-lr-cnt 0)
  (= WDATA.gpu-ds-cnt 0)
  (= WDATA.cpu-ds-cnt 0)
  (= WDATA.gpu-lr-elem 0)
  (= WDATA.cpu-lr-elem 0)
  (= WDATA.gpu-ds-elem 0)
  (= WDATA.cpu-ds-elem 0)

  (= WDATA.pen-ds-gpu-subm 0)
  (= WDATA.pen-ds-gpu-elem 0)
  (= WDATA.pen-lr-gpu-subm 0)
  (= WDATA.pen-lr-gpu-elem 0)
  (= WDATA.ds-cpu-time 0.0)
  (= WDATA.lr-cpu-time 0.0)
  (= WDATA.ds-gpu-time 0.0)
  (= WDATA.lr-gpu-time 0.0)
)

