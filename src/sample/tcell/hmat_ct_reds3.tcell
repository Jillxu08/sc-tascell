(def (task-body create_leafmtx)
  (create_leafmtx this.st-cltl this.st-cltt this.i1 this.i2))

(def (task-body CTdist1)
  ;; (csym::create-ctree-ssgeom zgmid face2node 0 0 nofc)
  (csym::create-ctree-ssgeom 0 zgmid f2n 0 0 0 nofc nofc 3)
  ;; (= outside-flag 1)
  ;; (= resultCTlist privateCTlist)
)

(def (task-body start-up)
  (= this.r (start-up this.th-ds this.th-lr)))

;; (def (start-up) (wfn int)
(def (start-up ds lr) (wfn int int int)
  (csym::fprintf stderr "Input file: %s~%" INPUT_DEFAULT)
  (csym::fprintf stderr "#proc:%d ~%" num-procs)
  (csym::fprintf stderr "th_ds:%d ~%" ds)
  (csym::fprintf stderr "th_lr:%d ~%" lr)
  (decl start double)
  (decl end double)
  (decl spent double)
  (= th-ds ds)
  (= th-lr lr)

  ;; 加载数据（每个进程独立执行）
  (tcell-broadcast data_load_task (:put) 
    (csym::load_data)
    (= countCT 0)
  )

  (def i int)
  (= start (csym::MPI_Wtime))
  (do-many for i from 0 to num-procs
    (csym::create-ctree-ssgeom 0 zgmid f2n 0 0 0 nofc nofc 3)
    (csym::fprintf stderr "CT count:%d~%" CTcounter)
		(handles CTdist1
      (:spawn-from (- i 1))
      (:node 2)
			(:put from j1 to j2)
			(:get)))
  (= end (csym::MPI_Wtime))
  (= spent (- end start))
  (csym::fprintf stderr "cluster tree time spent:%.10lf~%" spent)
  
  (def nCTn int)
  (= nCTn (csym::checkCT 0))
  (def depthCT int)
  (= depthCT (csym::depthCT 0))
  (csym::fprintf stderr "# cluster tree nodes:%d~%" nCTn)
  (csym::fprintf stderr "cluster tree depth:%d~%" depthCT)
  (def il int)
  (= start (csym::MPI_Wtime))
  (decl all int)
  (= all (* (fref (aref resultCTlist 0) nnson) (fref (aref resultCTlist 0) nnson)))
  (create_leafmtx 0 0 0 all)
  (= end (csym::MPI_Wtime))
  (= spent (- end start))
  (csym::fprintf stderr "BCT time spent:%.10lf~%" spent)
  
  ;; (tcell-broadcast BCT_cnt_task (:put) 
  ;;   (csym::BCT_cnt)
  ;;   ;; (csym::finalize-tcounter)
	;;   ;; (csym::show-counters)
  ;;   ;; (csym::Matrix_cnt)
  ;; )
  
  ;; ========== 修改：使用新的统计函数 ==========
  (tcell-broadcast BCT_cnt_task (:put) 
    (csym::BCT_cnt)
    ;; 每个进程打印本地统计
    ;; (csym::Matrix_cnt)
    (csym::Matrix_cnt_global)
  )

  ;; ========== 用 broadcast 确保所有进程执行 ==========
  ;; (tcell-broadcast GPU_report_task (:put)
  ;;   (csym::print_gpu_usage_report)
  ;;   (csym::cleanup_multi_gpu)
  ;; )

  (return 0))

(def (csym::med3 nl nr nlr2) (fn int int int int)
  (decl med3 int)
  (if (< nl nr)
      (begin
        (if (< nr nlr2)
            (begin (= med3 nr))
            (if (< nlr2 nl)
                (begin (= med3 nl))
                (begin (= med3 nlr2)))))
      (begin
        (if (< nlr2 nr)
            (begin (= med3 nr))
            (if (< nl nlr2) 
                (begin (= med3 nl))
                (begin (= med3 nlr2))))))
  (return med3))

(def (create_leafmtx st-cltl st-cltt i1 i2)
  (wfn void int int int int)
  (def ndl int (fref (aref resultCTlist st-cltl) nsize))
  (def ndt int (fref (aref resultCTlist st-cltt) nsize))
  (def nstrtl int (fref (aref resultCTlist st-cltl) nstrt))
  (def nstrtt int (fref (aref resultCTlist st-cltt) nstrt))
  (def nnsonl int (fref (aref resultCTlist st-cltl) nnson))
  (def nnsont int (fref (aref resultCTlist st-cltt) nnson))

  (decl ia int)
  (def nleaf double 40.0)
  (def zeta double 2.0)
  (def zdistlt double (csym::dist_2cluster st-cltl st-cltt))
  (if (and (or (<= (fref (aref resultCTlist st-cltl) zwdth) (* zdistlt zeta))
               (<= (fref (aref resultCTlist st-cltt) zwdth) (* zdistlt zeta)))
           (and (>= ndl nleaf) (>= ndt nleaf)))
    (begin
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) nstrtl) nstrtl)
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) ndl) ndl)
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) nstrtt) nstrtt)
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) ndt) ndt)
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) kt) 0)
      (= (fref (aref WDATA.leafnode-list WDATA.nlf) ltmtx) 1)
      (csym::fill_sub_leafmtx (ptr (aref WDATA.leafnode-list WDATA.nlf)) 0.0 WORKER-ID (ptr WDATA.gpu-lr-cnt) (ptr WDATA.cpu-lr-cnt) (ptr WDATA.gpu-ds-cnt) (ptr WDATA.cpu-ds-cnt) (ptr WDATA.gpu-lr-elem) (ptr WDATA.cpu-lr-elem) (ptr WDATA.gpu-ds-elem) (ptr WDATA.cpu-ds-elem) (ptr WDATA.pen-ds-gpu-subm) (ptr WDATA.pen-ds-gpu-elem) (ptr WDATA.pen-lr-gpu-subm) (ptr WDATA.pen-lr-gpu-elem) (ptr WDATA.ds-cpu-time) (ptr WDATA.lr-cpu-time) (ptr WDATA.ds-gpu-time) (ptr WDATA.lr-gpu-time))
      (+= WDATA.elem-sum (* (+ ndl ndt) (fref (aref WDATA.leafnode-list WDATA.nlf) kt)))
      (= WDATA.nlf (+ WDATA.nlf 1))
      ;; (if (and (and (== nstrtl 0) (== nstrtt 2620)) (and (== ndl 2620) (== ndt 10400)))
      ;;   (csym::exit 99)
      ;; )
    )
    (begin
      (if (or (== nnsonl 0) (== nnsont 0) (<= ndl nleaf) (<= ndt nleaf))
        (begin
	        (= (fref (aref WDATA.leafnode-list WDATA.nlf) nstrtl) nstrtl)
          (= (fref (aref WDATA.leafnode-list WDATA.nlf) ndl) ndl)
          (= (fref (aref WDATA.leafnode-list WDATA.nlf) nstrtt) nstrtt)
          (= (fref (aref WDATA.leafnode-list WDATA.nlf) ndt) ndt)
          (= (fref (aref WDATA.leafnode-list WDATA.nlf) ltmtx) 2)
          (csym::fill_sub_leafmtx (ptr (aref WDATA.leafnode-list WDATA.nlf)) 0.0 WORKER-ID (ptr WDATA.gpu-lr-cnt) (ptr WDATA.cpu-lr-cnt) (ptr WDATA.gpu-ds-cnt) (ptr WDATA.cpu-ds-cnt) (ptr WDATA.gpu-lr-elem) (ptr WDATA.cpu-lr-elem) (ptr WDATA.gpu-ds-elem) (ptr WDATA.cpu-ds-elem) (ptr WDATA.pen-ds-gpu-subm) (ptr WDATA.pen-ds-gpu-elem) (ptr WDATA.pen-lr-gpu-subm) (ptr WDATA.pen-lr-gpu-elem) (ptr WDATA.ds-cpu-time) (ptr WDATA.lr-cpu-time) (ptr WDATA.ds-gpu-time) (ptr WDATA.lr-gpu-time))
          (+= WDATA.elem-sum (* ndl ndt))
          (= WDATA.nlf (+ WDATA.nlf 1)))
        (begin
          (if (and (> ndl PB) (> ndt PB))
		        (begin
		          (do-many for ia from i1 to i2
                ;; TCELL-CHECK-REQ
		            (decl il int) (decl it int)
		            (= il (/ ia nnsont))
		            (= it (% ia nnsont))
		            (decl al int)
		            (= al (* (fref (aref resultCTlist (aref (fref (aref resultCTlist st-cltl) offsets) il)) nnson) 
                        (fref (aref resultCTlist (aref (fref (aref resultCTlist st-cltt) offsets) it)) nnson)))
		            (create_leafmtx (aref (fref (aref resultCTlist st-cltl) offsets) il) (aref (fref (aref resultCTlist st-cltt) offsets) it) 0 al)
		            (handles create_leafmtx
			            (:put from j1 to j2
                    (= this.st-cltl st-cltl)
			              (= this.st-cltt st-cltt)
			              (= this.i1 j1)
			              (= this.i2 j2))
			            (:get)))
            )
		        (begin
		          (for ((= ia i1) (< ia i2) (inc ia))
		            (decl il int) (decl it int)
		            (= il (/ ia nnsont))
		            (= it (% ia nnsont))
		            (decl al int)
		            (= al (* (fref (aref resultCTlist (aref (fref (aref resultCTlist st-cltl) offsets) il)) nnson)
                        (fref (aref resultCTlist (aref (fref (aref resultCTlist st-cltt) offsets) it)) nnson)))
		            (create_leafmtx (aref (fref (aref resultCTlist st-cltl) offsets) il) 
                                (aref (fref (aref resultCTlist st-cltt) offsets) it) 0 al)))
          )
        )))))

(def (csym::checkCT root) (fn int int)
  (def temp (ptr cluster))
  (= temp (ptr (aref resultCTlist root)))
  (if (== (fref (mref temp) nnson) 2)
    (begin
      (def left int)
      (def right int)
      (= left (csym::checkCT (aref (fref (mref temp) offsets) 0)))
      (= right (csym::checkCT (aref (fref (mref temp) offsets) 1)))
      (return (+ (+ left right) 1)))
    (begin
      (return 1))))

(def (csym::depthCT root) (fn int int)
  (def temp (ptr cluster))
  (= temp (ptr (aref resultCTlist root)))
  (if (== (fref (mref temp) nnson) 2)
    (begin
      (def left int)
      (def right int)
      (= left (csym::depthCT (aref (fref (mref temp) offsets) 0)))
      (= right (csym::depthCT (aref (fref (mref temp) offsets) 1)))
      (if (> left right)
        (return (+ left 1))
        (return (+ right 1))
      )
      (return (+ (+ left right) 1)))
    (begin
      (return 1))))

(def (csym::checkClusterTree f root) (fn void (ptr FILE) int)
  (def temp (ptr cluster))
  (= temp (ptr (aref resultCTlist root)))
  (def width double (fref (mref temp) zwdth))
  (csym::fprintf f "%lf~%" width)
  (if (== (fref (mref temp) nnson) 2)
    (begin
      (csym::checkClusterTree f (aref (fref (mref temp) offsets) 0))
      (csym::checkClusterTree f (aref (fref (mref temp) offsets) 1)))))

(def (csym::get-wall-time) (fn double void)
  (decl time (struct timeval))
  (if (csym::gettimeofday (ptr time) NULL) (begin (return 0)))
  (return (+ (cast double (fref time tv-sec)) (* (cast double (fref time tv-usec)) 0.000001))))

(def (csym::get-cpu-time) (fn double void)
  (return (/ (cast double (csym::clock)) CLOCKS-PER-SEC)))

(def (csym::BCT_cnt) (fn void void)
  (begin
    (def i int)
    (def j int)
    (def nlf-sum uint64_t 0)
    (def memory_sum uint64_t 0)
    (for ((= i 0) (< i num-thrs) (inc i))
      (def nlf-i uint64_t (fref (aref Wdata-list i) -> nlf))
      (if (> nlf-i BCTN)
        (begin
          (csym::fprintf stderr "nlf of counted by worker %d is larger than BCTN!~%" i)
          (csym::exit 99)))
      (+= nlf-sum nlf-i)
      (+= memory_sum (fref (aref Wdata-list i) -> elem-sum))
      
    )
    (csym::fprintf stderr "rank: %d, elem-sum=%llu nlf-sum= %llu~%" my-rank memory_sum nlf-sum)
  )
)

(def (csym::Matrix_cnt) (fn void void)
  (def i int)

  (def lr-cpu-sum uint64_t 0)
  (def lr-gpu-sum uint64_t 0)
  (def ds-cpu-sum uint64_t 0)
  (def ds-gpu-sum uint64_t 0)

  (def lr-cpu-elem-sum uint64_t 0)
  (def lr-gpu-elem-sum uint64_t 0)
  (def ds-cpu-elem-sum uint64_t 0)
  (def ds-gpu-elem-sum uint64_t 0)

  (def pen-ds-gpu-subm-sum uint64_t 0)
  (def pen-ds-gpu-elem-sum uint64_t 0)
  (def pen-lr-gpu-subm-sum uint64_t 0)
  (def pen-lr-gpu-elem-sum uint64_t 0)

  (def ds-cpu-total-time double 0.0)
  (def lr-cpu-total-time double 0.0)
  (def ds-gpu-total-time double 0.0)
  (def lr-gpu-total-time double 0.0)

  (for ((= i 0) (< i num-thrs) (inc i))
    (+= lr-cpu-sum (fref (aref Wdata-list i) -> cpu-lr-cnt))
    (+= lr-gpu-sum (fref (aref Wdata-list i) -> gpu-lr-cnt))
    (+= ds-cpu-sum (fref (aref Wdata-list i) -> cpu-ds-cnt))
    (+= ds-gpu-sum (fref (aref Wdata-list i) -> gpu-ds-cnt))

    (+= lr-cpu-elem-sum (fref (aref Wdata-list i) -> cpu-lr-elem))
    (+= lr-gpu-elem-sum (fref (aref Wdata-list i) -> gpu-lr-elem))
    (+= ds-cpu-elem-sum (fref (aref Wdata-list i) -> cpu-ds-elem))
    (+= ds-gpu-elem-sum (fref (aref Wdata-list i) -> gpu-ds-elem))

    (+= pen-ds-gpu-subm-sum (fref (aref Wdata-list i) -> pen-ds-gpu-subm))
    (+= pen-ds-gpu-elem-sum (fref (aref Wdata-list i) -> pen-ds-gpu-elem))
    (+= pen-lr-gpu-subm-sum (fref (aref Wdata-list i) -> pen-lr-gpu-subm))
    (+= pen-lr-gpu-elem-sum (fref (aref Wdata-list i) -> pen-lr-gpu-elem))

    (+= ds-cpu-total-time (fref (aref Wdata-list i) -> ds-cpu-time))
    (+= lr-cpu-total-time (fref (aref Wdata-list i) -> lr-cpu-time))
    (+= ds-gpu-total-time (fref (aref Wdata-list i) -> ds-gpu-time))
    (+= lr-gpu-total-time (fref (aref Wdata-list i) -> lr-gpu-time))

    ;; (csym::fprintf stderr "ds-cpu-time-%d=%.10lf  ds-cpu-total-time=%.10lf~%" i (fref (aref Wdata-list i) -> ds-cpu-time) ds-cpu-total-time)
)

  ;; ---- print results ----
  (csym::fprintf stderr
    "rank: %d, lr-cpu-subm=%llu lr-gpu-subm=%llu lr-subm-sum=%llu~%"
    my-rank lr-cpu-sum lr-gpu-sum (+ lr-cpu-sum lr-gpu-sum))

  (csym::fprintf stderr
    "rank: %d, ds-cpu-subm=%llu ds-gpu-subm=%llu ds-subm-sum=%llu~%"
    my-rank ds-cpu-sum ds-gpu-sum (+ ds-cpu-sum ds-gpu-sum))

  (csym::fprintf stderr
    "rank: %d, cpu-subm-sum=%llu gpu-subm-sum=%llu subm-sum=%llu~%"
    my-rank
    (+ lr-cpu-sum ds-cpu-sum)
    (+ lr-gpu-sum ds-gpu-sum)
    (+ lr-cpu-sum ds-cpu-sum lr-gpu-sum ds-gpu-sum))

  (csym::fprintf stderr
    "rank: %d, lr-cpu-elem=%llu lr-gpu-elem=%llu lr-elem-sum=%llu~%"
    my-rank lr-cpu-elem-sum lr-gpu-elem-sum (+ lr-cpu-elem-sum lr-gpu-elem-sum))

  (csym::fprintf stderr
    "rank: %d, ds-cpu-elem=%llu ds-gpu-elem=%llu ds-elem-sum=%llu~%"
    my-rank ds-cpu-elem-sum ds-gpu-elem-sum (+ ds-cpu-elem-sum ds-gpu-elem-sum))

  (csym::fprintf stderr
    "rank: %d, cpu-elem-sum=%llu gpu-elem-sum=%llu elem-sum=%llu~%"
    my-rank
    (+ lr-cpu-elem-sum ds-cpu-elem-sum)
    (+ lr-gpu-elem-sum ds-gpu-elem-sum)
    (+ lr-cpu-elem-sum ds-cpu-elem-sum lr-gpu-elem-sum ds-gpu-elem-sum))

  (csym::fprintf stderr
    "rank: %d, pen-ds-gpu-subm=%llu pen-ds-gpu-elem=%llu~%"
    my-rank pen-ds-gpu-subm-sum pen-ds-gpu-elem-sum)

  (csym::fprintf stderr
    "rank: %d, pen-lr-gpu-subm=%llu pen-lr-gpu-elem=%llu~%"
    my-rank pen-lr-gpu-subm-sum pen-lr-gpu-elem-sum)

  (csym::fprintf stderr
    "rank: %d, pen-gpu-subm=%llu pen-gpu-elem=%llu~%"
    my-rank
    (+ pen-ds-gpu-subm-sum pen-lr-gpu-subm-sum)
    (+ pen-ds-gpu-elem-sum pen-lr-gpu-elem-sum))

  (csym::fprintf stderr
    "rank: %d, ds-cpu-total-time=%.10lf lr-cpu-total-time=%.10lf cpu-total-time=%.10lf~%"
    my-rank ds-cpu-total-time lr-cpu-total-time (+ ds-cpu-total-time lr-cpu-total-time))
  (csym::fprintf stderr
    "rank: %d, ds-gpu-total-time=%.10lf lr-gpu-total-time=%.10lf gpu-total-time=%.10lf~%"
    my-rank ds-gpu-total-time lr-gpu-total-time (+ ds-gpu-total-time lr-gpu-total-time))
)

;; 在 Matrix_cnt 之后添加全局统计函数
(def (csym::Matrix_cnt_global) (fn void void)
  (def i int)
  (def my-rank-local int)
  (def num-processes-local int)
  
  ;; 本地累加器
  (def local-lr-cpu uint64_t 0)
  (def local-lr-gpu uint64_t 0)
  (def local-ds-cpu uint64_t 0)
  (def local-ds-gpu uint64_t 0)
  (def local-lr-cpu-elem uint64_t 0)
  (def local-lr-gpu-elem uint64_t 0)
  (def local-ds-cpu-elem uint64_t 0)
  (def local-ds-gpu-elem uint64_t 0)
  
  ;; 全局累加器
  (def global-lr-cpu uint64_t 0)
  (def global-lr-gpu uint64_t 0)
  (def global-ds-cpu uint64_t 0)
  (def global-ds-gpu uint64_t 0)
  (def global-lr-cpu-elem uint64_t 0)
  (def global-lr-gpu-elem uint64_t 0)
  (def global-ds-cpu-elem uint64_t 0)
  (def global-ds-gpu-elem uint64_t 0)
  
  ;; 获取 MPI 信息
  (csym::MPI_Comm_rank csym::MPI_COMM_WORLD (ptr my-rank-local))
  (csym::MPI_Comm_size csym::MPI_COMM_WORLD (ptr num-processes-local))
  
  ;; 收集本地统计
  (for ((= i 0) (< i num-thrs) (inc i))
    (+= local-lr-cpu (fref (aref Wdata-list i) -> cpu-lr-cnt))
    (+= local-lr-gpu (fref (aref Wdata-list i) -> gpu-lr-cnt))
    (+= local-ds-cpu (fref (aref Wdata-list i) -> cpu-ds-cnt))
    (+= local-ds-gpu (fref (aref Wdata-list i) -> gpu-ds-cnt))
    
    (+= local-lr-cpu-elem (fref (aref Wdata-list i) -> cpu-lr-elem))
    (+= local-lr-gpu-elem (fref (aref Wdata-list i) -> gpu-lr-elem))
    (+= local-ds-cpu-elem (fref (aref Wdata-list i) -> cpu-ds-elem))
    (+= local-ds-gpu-elem (fref (aref Wdata-list i) -> gpu-ds-elem))
  )
  
  ;; MPI Reduce 聚合
  (csym::MPI_Reduce (ptr local-lr-cpu) (ptr global-lr-cpu) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-lr-gpu) (ptr global-lr-gpu) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-ds-cpu) (ptr global-ds-cpu) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-ds-gpu) (ptr global-ds-gpu) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  
  (csym::MPI_Reduce (ptr local-lr-cpu-elem) (ptr global-lr-cpu-elem) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-lr-gpu-elem) (ptr global-lr-gpu-elem) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-ds-cpu-elem) (ptr global-ds-cpu-elem) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  (csym::MPI_Reduce (ptr local-ds-gpu-elem) (ptr global-ds-gpu-elem) 1 
                    csym::MPI_UNSIGNED_LONG_LONG csym::MPI_SUM 0 csym::MPI_COMM_WORLD)
  
  ;; 只让 rank 0 打印
  (if (== my-rank-local 0)
    (begin
      (csym::fprintf stderr "~%")
      (csym::fprintf stderr "╔════════════════════════════════════════════════════════════════════╗~%")
      (csym::fprintf stderr "║         GLOBAL Matrix Statistics (All %d Processes)               ║~%" num-processes-local)
      (csym::fprintf stderr "╚════════════════════════════════════════════════════════════════════╝~%")
      (csym::fprintf stderr "~%")
      
      (csym::fprintf stderr "Low-Rank Matrices:~%")
      (csym::fprintf stderr "  lr-cpu-subm=%llu lr-gpu-subm=%llu lr-total=%llu~%"
              global-lr-cpu global-lr-gpu (+ global-lr-cpu global-lr-gpu))
      (csym::fprintf stderr "  lr-cpu-elem=%llu lr-gpu-elem=%llu lr-total=%llu~%"
              global-lr-cpu-elem global-lr-gpu-elem (+ global-lr-cpu-elem global-lr-gpu-elem))
      
      (csym::fprintf stderr "~%Dense Matrices:~%")
      (csym::fprintf stderr "  ds-cpu-subm=%llu ds-gpu-subm=%llu ds-total=%llu~%"
              global-ds-cpu global-ds-gpu (+ global-ds-cpu global-ds-gpu))
      (csym::fprintf stderr "  ds-cpu-elem=%llu ds-gpu-elem=%llu ds-total=%llu~%"
              global-ds-cpu-elem global-ds-gpu-elem (+ global-ds-cpu-elem global-ds-gpu-elem))
      
      (csym::fprintf stderr "~%Total:~%")
      (csym::fprintf stderr "  total-subm=%llu  total-elem=%llu~%"
              (+ global-lr-cpu global-lr-gpu global-ds-cpu global-ds-gpu)
              (+ global-lr-cpu-elem global-lr-gpu-elem global-ds-cpu-elem global-ds-gpu-elem))
      
      (csym::fprintf stderr "~%")
    )
  )
  
  ;; 同步
  (csym::MPI_Barrier csym::MPI_COMM_WORLD)
)

(def (csym::load_data) (fn void void)
  (decl fname (ptr char))
  (decl file (ptr FILE))
  (def countOfNode int 0)
  (def count int 0)
  (decl i int)
  ;; (def coordOfNode (ptr (array double 3)))
  ;; (def coordOfFace (ptr (array double 3)))
  ;; (def face2node (ptr (array int 3)))
  (def bi (struct bem-input))
  (= fname INPUT-DEFAULT)
  (= file (fopen fname "r"))
  (if (== file NULL)
    (begin
      (csym::fprintf stderr "Error: Unable to input file '%s'!~%" fname)
      (csym::exit 99))
    (begin
      (if (== (csym::read-bem-input file (ptr bi) BI-AUTO) -1)
	      (begin
	        (csym::fprintf stderr "Bem input file read error!~%")
	        (csym::exit 99)))
      (csym::print-bem-input stderr (ptr bi) BI-PRETTY)
      (= countOfNode bi.nNode)
      (= bgmid bi.coordOfNode)
      (= count bi.nFace)
      (= zgmid bi.coordOfFace)
      (= f2n bi.face2node)))
  (csym::fclose file)

  (= nofc count)
  (= nNode countOfNode)

  (csym::data_transfer)
  (csym::fprintf stderr "Geometry data transferred to GPU~%")
  ;; ====================================
  ;; 初始化当前节点的 GPU 锁资源池
  ;; (csym::init_gpu_pool)
  ;; (csym::data_transfer)
  ;; (= privateCTlist (cast (ptr cluster) (csym::malloc (* (sizeof cluster) LN))))
  (= resultCTlist (cast (ptr cluster) (csym::malloc (* (sizeof cluster) LN))))
)
