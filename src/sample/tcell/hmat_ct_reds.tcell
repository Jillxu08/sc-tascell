(def (csym::Matrix_cnt) (fn void void)
  (def i int)

  (def lr-cpu-sum uint64_t 0)
  (def lr-gpu-sum uint64_t 0)
  (def ds-cpu-sum uint64_t 0)
  (def ds-gpu-sum uint64_t 0)

  (def lr-cpu-elem-sum uint64_t 0)
  (def lr-gpu-elem-sum uint64_t 0)
  (def ds-cpu-elem-sum uint64_t 0)
  (def ds-gpu-elem-sum uint64_t 0)

  (def pen-ds-gpu-subm-sum uint64_t 0)
  (def pen-ds-gpu-elem-sum uint64_t 0)
  (def pen-lr-gpu-subm-sum uint64_t 0)
  (def pen-lr-gpu-elem-sum uint64_t 0)

  (def ds-cpu-total-time double 0.0)
  (def lr-cpu-total-time double 0.0)
  (def ds-gpu-total-time double 0.0)
  (def lr-gpu-total-time double 0.0)

  (for ((= i 0) (< i num-thrs) (inc i))
    (+= lr-cpu-sum (fref (aref Wdata-list i) -> cpu-lr-cnt))
    (+= lr-gpu-sum (fref (aref Wdata-list i) -> gpu-lr-cnt))
    (+= ds-cpu-sum (fref (aref Wdata-list i) -> cpu-ds-cnt))
    (+= ds-gpu-sum (fref (aref Wdata-list i) -> gpu-ds-cnt))

    (+= lr-cpu-elem-sum (fref (aref Wdata-list i) -> cpu-lr-elem))
    (+= lr-gpu-elem-sum (fref (aref Wdata-list i) -> gpu-lr-elem))
    (+= ds-cpu-elem-sum (fref (aref Wdata-list i) -> cpu-ds-elem))
    (+= ds-gpu-elem-sum (fref (aref Wdata-list i) -> gpu-ds-elem))

    (+= pen-ds-gpu-subm-sum (fref (aref Wdata-list i) -> pen-ds-gpu-subm))
    (+= pen-ds-gpu-elem-sum (fref (aref Wdata-list i) -> pen-ds-gpu-elem))
    (+= pen-lr-gpu-subm-sum (fref (aref Wdata-list i) -> pen-lr-gpu-subm))
    (+= pen-lr-gpu-elem-sum (fref (aref Wdata-list i) -> pen-lr-gpu-elem))

    (+= ds-cpu-total-time (fref (aref Wdata-list i) -> ds-cpu-time))
    (+= lr-cpu-total-time (fref (aref Wdata-list i) -> lr-cpu-time))
    (+= ds-gpu-total-time (fref (aref Wdata-list i) -> ds-gpu-time))
    (+= lr-gpu-total-time (fref (aref Wdata-list i) -> lr-gpu-time))

    ;; (csym::fprintf stderr "ds-cpu-time-%d=%.10lf  ds-cpu-total-time=%.10lf~%" i (fref (aref Wdata-list i) -> ds-cpu-time) ds-cpu-total-time)
)

  ;; ---- print results ----
  (csym::fprintf stderr
    "lr-cpu-subm=%llu lr-gpu-subm=%llu lr-subm-sum=%llu~%"
    lr-cpu-sum lr-gpu-sum (+ lr-cpu-sum lr-gpu-sum))

  (csym::fprintf stderr
    "ds-cpu-subm=%llu ds-gpu-subm=%llu ds-subm-sum=%llu~%"
    ds-cpu-sum ds-gpu-sum (+ ds-cpu-sum ds-gpu-sum))

  (csym::fprintf stderr
    "cpu-subm-sum=%llu gpu-subm-sum=%llu subm-sum=%llu~%"
    (+ lr-cpu-sum ds-cpu-sum)
    (+ lr-gpu-sum ds-gpu-sum)
    (+ lr-cpu-sum ds-cpu-sum lr-gpu-sum ds-gpu-sum))

  (csym::fprintf stderr
    "lr-cpu-elem=%llu lr-gpu-elem=%llu lr-elem-sum=%llu~%"
    lr-cpu-elem-sum lr-gpu-elem-sum (+ lr-cpu-elem-sum lr-gpu-elem-sum))

  (csym::fprintf stderr
    "ds-cpu-elem=%llu ds-gpu-elem=%llu ds-elem-sum=%llu~%"
    ds-cpu-elem-sum ds-gpu-elem-sum (+ ds-cpu-elem-sum ds-gpu-elem-sum))

  (csym::fprintf stderr
    "cpu-elem-sum=%llu gpu-elem-sum=%llu elem-sum=%llu~%"
    (+ lr-cpu-elem-sum ds-cpu-elem-sum)
    (+ lr-gpu-elem-sum ds-gpu-elem-sum)
    (+ lr-cpu-elem-sum ds-cpu-elem-sum lr-gpu-elem-sum ds-gpu-elem-sum))

  (csym::fprintf stderr
    "pen-ds-gpu-subm=%llu pen-ds-gpu-elem=%llu~%"
    pen-ds-gpu-subm-sum pen-ds-gpu-elem-sum)

  (csym::fprintf stderr
    "pen-lr-gpu-subm=%llu pen-lr-gpu-elem=%llu~%"
    pen-lr-gpu-subm-sum pen-lr-gpu-elem-sum)

  (csym::fprintf stderr
    "pen-gpu-subm=%llu pen-gpu-elem=%llu~%"
    (+ pen-ds-gpu-subm-sum pen-lr-gpu-subm-sum)
    (+ pen-ds-gpu-elem-sum pen-lr-gpu-elem-sum))

  (csym::fprintf stderr
    "ds-cpu-total-time=%.10lf lr-cpu-total-time=%.10lf cpu-total-time=%.10lf~%"
    ds-cpu-total-time lr-cpu-total-time (+ ds-cpu-total-time lr-cpu-total-time))
  (csym::fprintf stderr
    "ds-gpu-total-time=%.10lf lr-gpu-total-time=%.10lf gpu-total-time=%.10lf~%"
    ds-gpu-total-time lr-gpu-total-time (+ ds-gpu-total-time lr-gpu-total-time))
)


  ;; ;; ---- print results ----
  ;; (csym::fprintf stderr "lr-cpu-subm=%" PRIu64 " lr-gpu-subm=%" PRIu64 "  lr-subm-sum=%" PRIu64 "~%"
  ;;                lr-cpu-sum lr-gpu-sum (+ lr-cpu-sum lr-gpu-sum))

  ;; (csym::fprintf stderr "ds-cpu-subm=%" PRIu64 " ds-gpu-subm=%" PRIu64 "  ds-subm-sum=%" PRIu64 "~%"
  ;;                ds-cpu-sum ds-gpu-sum (+ ds-cpu-sum ds-gpu-sum))

  ;; (csym::fprintf stderr "cpu-subm-sum=%" PRIu64 " gpu-subm-sum=%" PRIu64 " subm-sum=%" PRIu64 "~%"
  ;;                (+ lr-cpu-sum ds-cpu-sum)
  ;;                (+ lr-gpu-sum ds-gpu-sum)
  ;;                (+ lr-cpu-sum ds-cpu-sum lr-gpu-sum ds-gpu-sum))

  ;; (csym::fprintf stderr
  ;;   "lr-cpu-elem=%" PRIu64 " lr-gpu-elem=%" PRIu64 " lr-elem-sum=%" PRIu64 "~%"
  ;;   lr-cpu-elem-sum lr-gpu-elem-sum (+ lr-cpu-elem-sum lr-gpu-elem-sum))

  ;; (csym::fprintf stderr
  ;;   "ds-cpu-elem=%" PRIu64 " ds-gpu-elem=%" PRIu64 " ds-elem-sum=%" PRIu64 "~%"
  ;;   ds-cpu-elem-sum ds-gpu-elem-sum (+ ds-cpu-elem-sum ds-gpu-elem-sum))

  ;; (csym::fprintf stderr
  ;;   "cpu-elem-sum=%" PRIu64 " gpu-elem-sum=%" PRIu64 " elem-sum=%" PRIu64 "~%"
  ;;   (+ lr-cpu-elem-sum ds-cpu-elem-sum)
  ;;   (+ lr-gpu-elem-sum ds-gpu-elem-sum)
  ;;   (+ lr-cpu-elem-sum ds-cpu-elem-sum lr-gpu-elem-sum ds-gpu-elem-sum))

  ;; (csym::fprintf stderr
  ;;   "pen-ds-gpu-subm=%" PRIu64 " pen-ds-gpu-elem=%" PRIu64 "~%"
  ;;   pen-ds-gpu-subm-sum pen-ds-gpu-elem-sum)

  ;; (csym::fprintf stderr
  ;;   "pen-lr-gpu-subm=%" PRIu64 " pen-lr-gpu-elem=%" PRIu64 "~%"
  ;;   pen-lr-gpu-subm-sum pen-lr-gpu-elem-sum)

  ;; (csym::fprintf stderr
  ;;   "pen-gpu-subm=%" PRIu64 " pen-gpu-elem=%" PRIu64 "~%"
  ;;   (+ pen-ds-gpu-subm-sum pen-lr-gpu-subm-sum) (+ pen-ds-gpu-elem-sum pen-lr-gpu-elem-sum)
  ;; )

  ;; (csym::fprintf stderr
  ;;   "ds-cpu-total-time=%.10lf lr-cpu-total-time=%.10lf  cpu-total-time=%.10lf~%"
  ;;   ds-cpu-total-time lr-cpu-total-time (+ ds-cpu-total-time lr-cpu-total-time))
;; )

(def (csym::load_data) (fn void void)
  (decl fname (ptr char))
  (decl file (ptr FILE))
  (def countOfNode int 0)
  (def count int 0)
  (decl i int)
  ;; (def coordOfNode (ptr (array double 3)))
  ;; (def coordOfFace (ptr (array double 3)))
  ;; (def face2node (ptr (array int 3)))
  (def bi (struct bem-input))
  (= fname INPUT-DEFAULT)
  (= file (fopen fname "r"))
  (if (== file NULL)
    (begin
      (csym::fprintf stderr "Error: Unable to input file '%s'!~%" fname)
      (csym::exit 99))
    (begin
      (if (== (csym::read-bem-input file (ptr bi) BI-AUTO) -1)
	      (begin
	        (csym::fprintf stderr "Bem input file read error!~%")
	        (csym::exit 99)))
      (csym::print-bem-input stderr (ptr bi) BI-PRETTY)
      (= countOfNode bi.nNode)
      (= bgmid bi.coordOfNode)
      (= count bi.nFace)
      (= zgmid bi.coordOfFace)
      (= f2n bi.face2node)))
  
  (csym::fclose file)

  (= nofc count)
  (= nNode countOfNode)
  (csym::data_transfer)

  (csym::fprintf stderr "nofc=%d, nNode=%d ~%" nofc nNode)
  ;; (= privateCTlist (cast (ptr cluster) (csym::malloc (* (sizeof cluster) LN))))
  (= resultCTlist (cast (ptr cluster) (csym::malloc (* (sizeof cluster) LN))))

)