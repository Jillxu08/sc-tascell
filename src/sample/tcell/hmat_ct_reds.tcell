(def (start-up ds lr) (wfn int int int)
  (csym::fprintf stderr "Input file: %s~%" INPUT_DEFAULT)
  ;; (csym::fprintf stderr "#proc:%d ~%" num-procs)
  (decl start double)
  (decl end double)
  (decl spent double)
  (= denseB 0)

  (= th-ds ds)
  (= th-lr lr)

  ;; (tcell-broadcast data_load_task (:put) 
  ;;   (csym::load_data)
  ;;   (= countCT 0)
  ;; )
  (csym::load_data)

  (def i int)
  (= start (csym::get-wall-time))
  ;; (do-many for i from 0 to num-procs
  ;;   ;; (csym::create-ctree-ssgeom zgmid face2node 0 0 nofc)
  ;;   (csym::create-ctree-ssgeom 0 zgmid f2n 0 0 0 nofc nofc 3)
  ;;   (= outside-flag 1)
  ;;   ;; (= resultCTlist privateCTlist)
  ;;   ;; (if (and (== my_rank 0))
  ;;   ;;   (begin
  ;;   ;;     (decl all int)
  ;;   ;;     (= all (* (fref (aref resultCTlist 0) nnson) (fref (aref resultCTlist 0) nnson)))
  ;;   ;;     ;; (csym::fprintf stderr "my_rank:%d, workerID:%d ~%" my_rank WORKER-ID)
  ;;   ;;     (create_leafmtx 0 0 0 all zgmid node face2node)
  ;;   ;;   )
  ;;   ;; )
  ;;   (csym::fprintf stderr "CT count:%d~%" CTcounter)
	;; 	(handles CTdist1
  ;;     (:spawn-from (- i 1))
  ;;     (:node 2)
	;; 		(:put from j1 to j2)
	;; 		(:get)))
  (csym::create-ctree-ssgeom 0 zgmid f2n 0 0 0 nofc nofc 3)
  (= end (csym::get-wall-time))
  (= spent (- end start))
  (csym::fprintf stderr "cluster tree time spent:%.10lf~%" spent)
  (def nCTn int)
  (= nCTn (csym::checkCT 0))
  (def depthCT int)
  (= depthCT (csym::depthCT 0))
  (csym::fprintf stderr "# cluster tree nodes:%d~%" nCTn)
  (csym::fprintf stderr "cluster tree depth:%d~%" depthCT)
  (def il int)
  ;; (csym::fprintf stderr "#CT=%d~%" countCT)
  ;; (for ((= il 0) (< il nofc) (inc il))
  ;;   (csym::fprintf stderr "#face:%d %f %f %f~%" 
  ;;     il
  ;;     (aref zgmid il 0)
  ;;     (aref zgmid il 1)
  ;;     (aref zgmid il 2)
  ;;   )
  ;; )
  ;; (for ((= il 0) (< il nNode) (inc il))
  ;;   (csym::fprintf stderr "#node:%d %f %f %f~%" 
  ;;     il
  ;;     (aref bgmid il 0)
  ;;     (aref bgmid il 1)
  ;;     (aref bgmid il 2)
  ;;   )
  ;; )
  ;; (for ((= il 0) (< il nofc) (inc il))
  ;;   (csym::fprintf stderr "#face2node:%d %d %d %d~%" 
  ;;     il
  ;;     (aref f2n il 0)
  ;;     (aref f2n il 1)
  ;;     (aref f2n il 2)
  ;;   )
  ;; )
  ;; (for ((= il 0) (< il countCT) (inc il))
  ;;   (csym::fprintf stderr "#CT:%d %f~%" 
  ;;     il
  ;;     (fref (aref resultCTlist il) zwdth)
  ;;   )  
  ;; )

  (= start (csym::get-wall-time))
  (decl all int)
  (= all (* (fref (aref resultCTlist 0) nnson) (fref (aref resultCTlist 0) nnson)))
  (create_leafmtx 0 0 0 all)
  (= end (csym::get-wall-time))
  (= spent (- end start))
  (csym::fprintf stderr "BCT time spent:%.10lf~%" spent)
  ;; (csym::fprintf stderr "LR: GPU count:%d, CPU count:%d, WORKER-ID:%d~%" WDATA.gpu-lr-cnt WDATA.cpu-lr-cnt WORKER-ID)                   
  ;; (csym::fprintf stderr "DS: GPU count:%d, CPU count:%d, WORKER-ID:%d~%" WDATA.gpu-ds-cnt WDATA.cpu-ds-cnt WORKER-ID)      
  ;; (csym::fprintf stderr "LR: GPU-sum=%d CPU-sum= %d~%" p q)
  ;; (csym::fprintf stderr "DS: GPU-sum=%d CPU-sum= %d~%" m n)
  ;; (csym::fprintf stderr "dense-sum=%d low_rank-sum= %d total=%d~%" dense low_rank (+ dense low_rank))
  
  ;; (tcell-broadcast BCT_cnt_task (:put) 
  ;;   (csym::BCT_cnt)
  ;;   ;; (csym::finalize-tcounter)
	;;   ;; (csym::show-counters)
  ;; )
  (csym::BCT_cnt)
  (csym::Matrix_cnt)
  ;; (csym::print_call_stats)
  ;; (csym::fprintf stderr "dense BCT count:%d~%" denseB)

  (return 0))

